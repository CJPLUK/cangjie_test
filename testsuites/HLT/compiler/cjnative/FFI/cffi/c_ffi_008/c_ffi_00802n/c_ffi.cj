// LEVEL:2
// DEPENDENCE: %n.c cfg.json
// EXEC: %sed %sed_opt "s!cangjieCFFI_path!%cstring_cjo!g" cfg.json
// EXEC: %clang %clang_opt %n.c -o %cffi_output
// EXEC-PIPE-1: %compiler %cmp_opt %ffic_opt -o %output 2>&1 | compare %f



foreign func testfunc(): CPointer<Bool>

foreign func testfunc1(): CPointer<Bool> { 
    return testfunc()
}

unsafe main():Int64 {
    var ptr: CPointer<Bool> = testfunc1()

    if (!ptr.isNotNull()) {
        return 1
    }

    if (ptr.isNull()) {
        return 2
    }

    if (!ptr.read(0) || ptr.read(1)) {
        return 3
    }

    print("CPointer Type Bool\n")
    return 0
}
// ASSERT: scan parse_foreign_function_with_body
