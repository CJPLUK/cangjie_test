// `cjpm test -i` with '--compat-version' records the target in the incremental cache on
// the first run and reuses it on the second.
// DEPENDENCE: ../%n
// EXEC: cd %n && %cjpm test -i --compat-version 1.3 -V 2>&1 | compare %f
// ASSERT: regex Compiling test runner: [^\r\n]*--compat-version=1.3
// ASSERT: regex Compiling test package `demo`: [^\r\n]*--compat-version=1.3
// ASSERT: scan cjpm test success
